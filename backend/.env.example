# ===========================================
# SMARTPROPERTY BACKEND - ENVIRONMENT VARIABLES
# ===========================================
# Development Environment

# Application
NODE_ENV=development
PORT=3000
APP_NAME=SmartProperty API

# MongoDB Configuration
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=smartproperty
MONGODB_USERNAME=smartproperty_user
MONGODB_PASSWORD=smartproperty_pass_2024
MONGODB_URI=mongodb://smartproperty_user:smartproperty_pass_2024@localhost:27017/smartproperty?authSource=admin

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password_2024
REDIS_URL=redis://:redis_dev_password_2024@localhost:6379

# JWT Configuration
JWT_SECRET=smartproperty_jwt_secret_dev_2024_change_in_prod
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=smartproperty_refresh_secret_dev_2024
JWT_REFRESH_EXPIRATION=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# AWS S3 Configuration (for file uploads)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=smartproperty-uploads

# Email Configuration (Nodemailer with SMTP support)
# Supports: Office 365, Gmail, SendGrid, MailHog, or any SMTP server
# For MailHog (development): host=localhost, port=1025, secure=false
# For Office 365: host=smtp.office365.com, port=587, secure=false, auth required
# For Gmail App Password: host=smtp.gmail.com, port=587, secure=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=SmartProperty
SMTP_FROM_EMAIL=noreply@smartproperty.com

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Google OAuth Configuration
# ⚠️ IMPORTANT: Get these from Google Cloud Console
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add authorized redirect URI: http://localhost:3000/api/auth/google/callback
# 4. Copy Client ID and Client Secret below
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
GOOGLE_FRONTEND_CALLBACK_URL=http://localhost:5173/auth/google/callback

# Facebook OAuth Configuration
# ⚠️ IMPORTANT: Get these from Facebook Developer Console
# 1. Go to https://developers.facebook.com/apps
# 2. Create a new app or select existing one
# 3. Add Facebook Login product
# 4. Add Valid OAuth Redirect URI: http://localhost:3000/api/auth/facebook/callback
# 5. Copy App ID and App Secret below
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/facebook/callback
FACEBOOK_FRONTEND_CALLBACK_URL=http://localhost:5173/auth/facebook/callback

# Logging
LOG_LEVEL=debug

# GraphQL
GRAPHQL_PLAYGROUND=true
GRAPHQL_DEBUG=true

# Stripe Configuration (Payment Processing)
# Set these locally on each machine; do not commit real secrets.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2024-04-10

PAYMENT_SUCCESS_URL=http://localhost:5173/payments/success
PAYMENT_CANCEL_URL=http://localhost:5173/payments/cancel

# reCAPTCHA Configuration
RECAPTCHA_SECRET_KEY=
RECAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify